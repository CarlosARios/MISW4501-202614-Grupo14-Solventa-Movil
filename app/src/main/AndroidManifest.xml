<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Captura del documento de identidad en el registro (HU-M1.1-01) y,
         más adelante, de la evidencia del siniestro (HU-M2.1-01). Se pide en
         caliente: hasta que el usuario llegue a la captura, la aplicación
         funciona sin ella. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- La evidencia del siniestro lleva el lugar donde se tomó, que es lo
         que la hace verificable (HU-M2.1-01, criterios 1 y 4). Se pide en
         caliente, junto con la cámara, al entrar a la captura. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Desde Android 12 el usuario puede conceder solo la ubicación
         aproximada, y el sistema exige declarar las dos. Con la aproximada la
         captura sigue funcionando: la evidencia queda marcada como de
         ubicación no confiable (criterio 3). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Ingreso y renovación de la sesión contra el user pool de Cognito, y
         las llamadas al API Gateway. Es un permiso normal: se concede al
         instalar y no se pide en caliente. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Saber si hay red (HU-M1.3-01): la consulta de consentimientos avisa
         cuando muestra la copia sin conexion y se actualiza sola al volver la
         red. ConnectivityManager lo exige; hasta ahora solo llegaba por el
         manifiesto de WorkManager. Es un permiso normal. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- No se exige cámara para instalar: un dispositivo sin ella puede usar
         el resto de la aplicación, y el emulador de las pruebas nocturnas no
         siempre la tiene. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Tampoco se exige GPS: sin él la evidencia se captura igual y queda
         marcada como de ubicación no confiable. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:name=".SolventaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Solventa">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Solventa"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- WorkManager se inicializa bajo demanda con la configuración de
             SolventaApp: su inicializador por omisión crearía una instancia
             sin la fábrica de Hilt. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>